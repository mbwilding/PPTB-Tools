{
    "name": "@mbwilding/tool-early-bound-generator",
    "displayName": "Early Bound Generator",
    "version": "0.0.20",
    "description": "Generate strongly-typed C# early-bound classes for Dataverse entities, option sets, and messages",
    "icon": "icons/ebg.svg",
    "contributors": [
        {
            "name": "Matthew Wilding",
            "url": "https://github.com/mbwilding"
        }
    ],
    "license": "GPL-2.0",
    "configurations": {
        "repository": "https://github.com/mbwilding/PPTB-Tools/tree/main/tools/early-bound-generator",
        "readmeUrl": "https://raw.githubusercontent.com/mbwilding/PPTB-Tools/refs/heads/main/tools/early-bound-generator/README.md",
        "pptbToolId": "3219642b-638a-45c8-97d5-34d1fbc0d3ba"
    },
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:watch": "vite build --watch",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "validate": "pptb-validate",
        "finalize-package": "npm shrinkwrap",
        "lint": "eslint --fix .",
        "pretty": "prettier --write .",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "keywords": [
        "powerplatform",
        "dataverse",
        "toolbox",
        "early-bound",
        "code-gen",
        "source-gen"
    ],
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.4",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-docs": "^10.5.8",
        "@storybook/react-vite": "^10.5.8",
        "@types/node": "^20.19.21",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.5.8",
        "happy-dom": "^20.9.0",
        "prettier": "^3.8.3",
        "storybook": "^10.5.8",
        "typescript": "^5.9.3",
        "vite": "^7.1.10",
        "vitest": "^4.1.10"
    }
}
